{
  "model": {
    "name": "Qwen/Qwen2.5-3B-Instruct",
    "target_modules": ["q_proj", "v_proj"],
    "max_length": 128,
    "load_in_4bit": true
  },
  "dataset": {
    "hub_path": "nyu-mll/glue",
    "subset": "sst2",
    "train_split": "train",
    "validation_split": "validation",
    "text_column": "sentence",
    "label_column": "label",
    "max_train_examples": 4096,
    "eval_examples": 872,
    "eval_offset": 0,
    "eval_shuffle_seed": 314159
  },
  "experiment": {
    "methods": [
      "freshness",
      "vast",
      "mtip",
      "mtip_adaptive",
      "mtip_hybrid",
      "mtip_routed"
    ],
    "seeds": [2026, 2027, 2028, 2029, 2030],
    "num_clients": 8,
    "shards_per_client": 1,
    "client_ranks": [4, 8, 16, 4, 8, 16, 4, 8],
    "compute_times": [1.0, 1.3, 2.0, 3.2, 5.0, 8.0, 13.0, 21.0],
    "warmup_returns": 4,
    "collected_returns": 32,
    "local_steps": 2,
    "gradient_accumulation_steps": 2,
    "local_batch_size": 1,
    "local_learning_rate": 0.0002,
    "weight_decay": 0.0,
    "gradient_clip_norm": 1.0,
    "server_update_weight": 0.5,
    "server_max_rank": 16,
    "history_size": 8,
    "reference_rank": 2,
    "reference_decay": 0.1,
    "reference_singular_power": 0.0,
    "adaptive_energy": 0.9,
    "adaptive_min_rank": 2,
    "adaptive_max_rank": 16,
    "adaptive_singular_power": 1.0,
    "residual_beta": 0.5,
    "residual_staleness_center": 4.0,
    "residual_staleness_temperature": 1.0,
    "freshness_lambda": 0.17328679513998632,
    "rank_rtol": 0.00001,
    "eval_batch_size": 4
  },
  "output_dir": "outputs/kaggle_3b_tradeoff"
}
