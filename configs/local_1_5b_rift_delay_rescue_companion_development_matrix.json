{
  "name": "riftlora-local-1.5b-delay-rescue-companion-development-offset512",
  "required_schema_version": 4,
  "description": "Frozen development companion for paired screening of delay-budget RIFT against its two strongest matched controls. Not an official confirmation matrix.",
  "runner": {
    "script": "scripts/run_kaggle_3b.py",
    "buffer_size": 1,
    "schedule_mode": "async"
  },
  "experiment": {
    "warmup_returns": 4,
    "collected_returns": 16,
    "calibration_sampling": "stratified",
    "component_score_objective": "class_nll",
    "calibration_gate_objective": "class_nll",
    "monitor_objective": "class_nll",
    "eval_batch_size": 1
  },
  "tasks": [
    {
      "name": "qnli",
      "base_config": "configs/local_1_5b_rift_development.json",
      "subset": "qnli",
      "task": "qnli",
      "validation_split": "validation",
      "question_column": "question",
      "sentence_column": "sentence",
      "label_column": "label",
      "label_texts": [" yes", " no"],
      "max_train_examples": 512,
      "eval_examples": 96,
      "eval_offset": 512,
      "model_overrides": {"max_length": 128},
      "experiment_overrides": {
        "calibration_gradient_examples": 8,
        "calibration_gate_examples": 24,
        "monitor_examples": 24
      }
    },
    {
      "name": "mnli_m",
      "run_name": "mnli_m",
      "base_config": "configs/local_1_5b_rift_development.json",
      "subset": "mnli",
      "task": "mnli",
      "validation_split": "validation_matched",
      "premise_column": "premise",
      "hypothesis_column": "hypothesis",
      "label_column": "label",
      "label_texts": [" true", " unknown", " false"],
      "prompt_style": "truth_value",
      "max_train_examples": 512,
      "eval_examples": 96,
      "eval_offset": 512,
      "model_overrides": {"max_length": 192},
      "experiment_overrides": {
        "calibration_gradient_examples": 9,
        "calibration_gate_examples": 24,
        "monitor_examples": 24
      }
    },
    {
      "name": "mnli_mm",
      "run_name": "mnli_mm",
      "base_config": "configs/local_1_5b_rift_development.json",
      "subset": "mnli",
      "task": "mnli",
      "validation_split": "validation_mismatched",
      "premise_column": "premise",
      "hypothesis_column": "hypothesis",
      "label_column": "label",
      "label_texts": [" true", " unknown", " false"],
      "prompt_style": "truth_value",
      "max_train_examples": 512,
      "eval_examples": 96,
      "eval_offset": 512,
      "model_overrides": {"max_length": 192},
      "experiment_overrides": {
        "calibration_gradient_examples": 9,
        "calibration_gate_examples": 24,
        "monitor_examples": 24
      }
    }
  ],
  "regimes": [
    {
      "name": "delay_budget_rescue",
      "partition_mode": "label_shard",
      "client_ranks": [2, 4, 8, 4],
      "compute_times": [1.0, 2.0, 5.0, 10.0]
    }
  ],
  "methods": ["spectral_filter", "alignfed_calibration"],
  "seeds": [4101, 4102, 4103],
  "notes": [
    "Uses the same examples, schedule, seeds, calibration sizes, and local-training config as the delay-budget RIFT development matrix.",
    "The RIFT rescue parameters are intentionally absent because neither control consumes them.",
    "All declared seeds must be reported; seed filtering is prohibited."
  ]
}
