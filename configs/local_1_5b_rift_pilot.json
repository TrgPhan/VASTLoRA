{
  "model": {
    "name": "Qwen/Qwen2.5-1.5B-Instruct",
    "target_modules": ["q_proj", "v_proj"],
    "max_length": 64,
    "load_in_4bit": true
  },
  "dataset": {
    "hub_path": "nyu-mll/glue",
    "subset": "sst2",
    "task": "sst2",
    "train_split": "train",
    "validation_split": "validation",
    "text_column": "sentence",
    "label_column": "label",
    "label_texts": [" negative", " positive"],
    "max_train_examples": 256,
    "eval_examples": 32,
    "eval_offset": 0,
    "eval_shuffle_seed": 314159
  },
  "experiment": {
    "methods": [
      "fedex",
      "freshness",
      "spectral_filter",
      "alignfed_calibration",
      "rift"
    ],
    "seeds": [2101],
    "num_clients": 6,
    "shards_per_client": 1,
    "partition_mode": "label_shard",
    "client_ranks": [2, 4, 8, 2, 4, 8],
    "compute_times": [1.0, 1.5, 3.0, 6.0, 12.0, 24.0],
    "warmup_returns": 2,
    "collected_returns": 2,
    "local_steps": 1,
    "gradient_accumulation_steps": 1,
    "local_batch_size": 1,
    "local_learning_rate": 0.0002,
    "weight_decay": 0.0,
    "gradient_clip_norm": 1.0,
    "server_update_weight": 0.5,
    "server_max_rank": 8,
    "history_size": 4,
    "reference_rank": 2,
    "reference_decay": 0.1,
    "reference_singular_power": 0.0,
    "adaptive_energy": 0.9,
    "adaptive_min_rank": 2,
    "adaptive_max_rank": 8,
    "adaptive_singular_power": 1.0,
    "residual_beta": 0.5,
    "residual_staleness_center": 4.0,
    "residual_staleness_temperature": 1.0,
    "freshness_lambda": 0.17328679513998632,
    "rank_rtol": 0.00001,
    "calibration_gradient_examples": 2,
    "calibration_gradient_batch_size": 1,
    "calibration_gate_examples": 8,
    "monitor_examples": 8,
    "component_score_objective": "class_nll",
    "calibration_gate_objective": "class_nll",
    "monitor_objective": "class_nll",
    "late_tau": 4,
    "extreme_tau": 8,
    "rift_step_scales": [1.0, 0.5, 0.25, 0.125],
    "rift_include_freshness_fallback": true,
    "rift_minimum_predicted_gain": 0.0,
    "rift_max_mean_increase": 0.0,
    "spectral_filter_scale": 1.0,
    "alignfed_calibration_scales": [1.0, 0.5, 0.25, 0.125],
    "eval_batch_size": 1
  },
  "output_dir": "outputs/local_1_5b_rift_pilot"
}
