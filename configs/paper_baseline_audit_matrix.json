{
  "name": "paper-baseline-development-v1",
  "required_schema_version": 5,
  "description": "Development only. Expanded spectral protocol and separate buffered AlignFed reference audit. Do not merge with v3 confirmation.",
  "runner": {"script": "scripts/run_kaggle_3b.py", "buffer_size": 1, "schedule_mode": "async"},
  "experiment": {
    "warmup_returns": 8,
    "collected_returns": 32,
    "server_update_weight": 1.0,
    "calibration_sampling": "stratified",
    "calibration_gradient_examples": 128,
    "calibration_gradient_batch_size": 1,
    "calibration_gate_examples": 48,
    "monitor_examples": 48,
    "eval_batch_size": 1,
    "component_score_objective": "class_nll",
    "calibration_gate_objective": "class_nll",
    "monitor_objective": "class_nll",
    "harm_epsilon": 0.000001,
    "spectral_surgery": {"policy": "smooth_abs", "preserve_energy": "l1"},
    "spectral_edit_target_modules": ["o_proj", "down_proj"],
    "spectral_posthoc_base_method": "freshness"
  },
  "alignfed_reference": {
    "max_pending": 4,
    "max_wait": 5.0,
    "representation_weight": 0.1,
    "gamma": 0.2,
    "steps": 3,
    "learning_rate": 0.01
  },
  "tasks": [
    {
      "name": "sst2", "task": "sst2", "subset": "sst2",
      "base_config": "configs/local_1_5b_rift_development.json",
      "text_column": "sentence", "label_column": "label",
      "validation_split": "validation", "eval_offset": 0, "eval_examples": 512,
      "max_train_examples": 512,
      "model_overrides": {"max_length": 192, "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]}
    },
    {
      "name": "qnli", "task": "qnli", "subset": "qnli",
      "base_config": "configs/local_1_5b_rift_development.json",
      "question_column": "question", "sentence_column": "sentence", "label_column": "label",
      "label_texts": [" yes", " no"],
      "validation_split": "validation", "eval_offset": 0, "eval_examples": 1024,
      "max_train_examples": 512,
      "model_overrides": {"max_length": 192, "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]}
    },
    {
      "name": "mnli_m", "run_name": "mnli_m", "task": "mnli", "subset": "mnli",
      "base_config": "configs/local_1_5b_rift_development.json",
      "premise_column": "premise", "hypothesis_column": "hypothesis", "label_column": "label",
      "label_texts": [" true", " unknown", " false"], "prompt_style": "truth_value",
      "validation_split": "validation_matched", "eval_offset": 0, "eval_examples": 1024,
      "max_train_examples": 512,
      "model_overrides": {"max_length": 192, "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]}
    },
    {
      "name": "mnli_mm", "run_name": "mnli_mm", "task": "mnli", "subset": "mnli",
      "base_config": "configs/local_1_5b_rift_development.json",
      "premise_column": "premise", "hypothesis_column": "hypothesis", "label_column": "label",
      "label_texts": [" true", " unknown", " false"], "prompt_style": "truth_value",
      "validation_split": "validation_mismatched", "eval_offset": 0, "eval_examples": 1024,
      "max_train_examples": 512,
      "model_overrides": {"max_length": 192, "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]}
    }
  ],
  "regimes": [{"name": "noniid_homogeneous_rank", "partition_mode": "label_shard", "client_ranks": [8, 8, 8, 8], "compute_times": [1, 2, 5, 10]}],
  "methods": ["raw", "freshness", "spectral_surgery", "spectral_surgery_posthoc", "alignfed_calibration", "rift", "rift_diag", "rift_core"],
  "seeds": [7201, 7202, 7203]
}
