{
  "name": "rift-core-scaled-development-v2",
  "required_schema_version": 5,
  "description": "Expanded development matrix with stronger baselines, larger evaluation sets and corrected safety metrics.",
  "runner": {
    "script": "scripts/run_kaggle_3b.py",
    "buffer_size": 1,
    "schedule_mode": "async"
  },
  "experiment": {
    "warmup_returns": 4,
    "collected_returns": 16,
    "calibration_sampling": "stratified",
    "calibration_gradient_examples": 24,
    "calibration_gate_examples": 48,
    "monitor_examples": 48,
    "calibration_gradient_batch_size": 1,
    "eval_batch_size": 1,
    "component_score_objective": "class_nll",
    "calibration_gate_objective": "class_nll",
    "monitor_objective": "class_nll",
    "harm_epsilon": 0.000001,
    "rift_component_gain_mass": 1,
    "rift_gate_min_staleness": 4,
    "rift_gate_selection": "largest_safe_scale",
    "rift_gate_confidence_z": 0.25,
    "rift_max_mean_increase": 0,
    "rift_step_scales": [
      1,
      0.5,
      0.25
    ],
    "rift_include_freshness_fallback": true,
    "late_tau": 4,
    "extreme_tau": 8,
    "rift_core": {
      "steps": 3,
      "learning_rate": 0.03,
      "radius": 0.5,
      "proximal_weight": 0.01,
      "delay_scale": 8
    }
  },
  "tasks": [
    {
      "name": "sst2",
      "subset": "sst2",
      "task": "sst2",
      "validation_split": "validation",
      "text_column": "sentence",
      "label_texts": [
        " negative",
        " positive"
      ],
      "eval_offset": 0,
      "base_config": "configs/local_1_5b_rift_development.json",
      "label_column": "label",
      "max_train_examples": 512,
      "eval_examples": 512,
      "model_overrides": {
        "max_length": 192
      }
    },
    {
      "name": "qnli",
      "subset": "qnli",
      "task": "qnli",
      "validation_split": "validation",
      "question_column": "question",
      "sentence_column": "sentence",
      "label_texts": [
        " yes",
        " no"
      ],
      "eval_offset": 1024,
      "base_config": "configs/local_1_5b_rift_development.json",
      "label_column": "label",
      "max_train_examples": 512,
      "eval_examples": 512,
      "model_overrides": {
        "max_length": 192
      }
    },
    {
      "name": "mnli_m",
      "run_name": "mnli_m",
      "subset": "mnli",
      "task": "mnli",
      "validation_split": "validation_matched",
      "premise_column": "premise",
      "hypothesis_column": "hypothesis",
      "label_texts": [
        " true",
        " unknown",
        " false"
      ],
      "prompt_style": "truth_value",
      "eval_offset": 1024,
      "base_config": "configs/local_1_5b_rift_development.json",
      "label_column": "label",
      "max_train_examples": 512,
      "eval_examples": 512,
      "model_overrides": {
        "max_length": 128
      }
    },
    {
      "name": "mnli_mm",
      "run_name": "mnli_mm",
      "subset": "mnli",
      "task": "mnli",
      "validation_split": "validation_mismatched",
      "premise_column": "premise",
      "hypothesis_column": "hypothesis",
      "label_texts": [
        " true",
        " unknown",
        " false"
      ],
      "prompt_style": "truth_value",
      "eval_offset": 1024,
      "base_config": "configs/local_1_5b_rift_development.json",
      "label_column": "label",
      "max_train_examples": 512,
      "eval_examples": 512,
      "model_overrides": {
        "max_length": 128
      }
    }
  ],
  "regimes": [
    {
      "name": "noniid_high_staleness",
      "partition_mode": "label_shard",
      "client_ranks": [
        2,
        4,
        8,
        4
      ],
      "compute_times": [
        1,
        2,
        5,
        10
      ]
    },
    {
      "name": "iid_homogeneous",
      "partition_mode": "iid",
      "client_ranks": [
        4,
        4,
        4,
        4
      ],
      "compute_times": [
        1,
        1,
        1,
        1
      ]
    }
  ],
  "methods": [
    "raw",
    "freshness",
    "fedrot",
    "spectral_filter",
    "alignfed_calibration",
    "rift",
    "rift_diag",
    "rift_core"
  ],
  "seeds": [
    5101,
    5102,
    5103
  ],
  "notes": [
    "All methods share train, calibration, eval examples, schedules and local compute. Core methods use extra server gradients: report cost.",
    "RIFT here is a gate-only filter reference without high-gain rescue, not the earlier positive-filter-rescue candidate.",
    "SST-2 uses 512 validation examples for development. QNLI/MNLI use 512 examples from offset1024; none overlap the confirmation windows.",
    "Raw and freshness are async references. FedRot is included after the factor-convention no-op fix; it is a matched simulator port.",
    "RIFT-Diag has the same repair steps, data and gate as RIFT-Core and is required to isolate the value of off-diagonal core terms.",
    "Full and diagonal repair both fit on gradient split then select rank-projected states on gate split; monitor/eval never used for selection."
  ]
}
