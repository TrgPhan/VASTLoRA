{
  "name": "rift-core-heldout-confirmation-v3",
  "required_schema_version": 5,
  "description": "Held-out confirmation with expanded evaluation sets, corrected safety metrics and paper-faithful competitor operators.",
  "runner": {
    "script": "scripts/run_kaggle_3b.py",
    "buffer_size": 1,
    "schedule_mode": "async"
  },
  "experiment": {
    "warmup_returns": 8,
    "collected_returns": 32,
    "calibration_sampling": "stratified",
    "calibration_gradient_examples": 24,
    "calibration_gate_examples": 48,
    "monitor_examples": 48,
    "calibration_gradient_batch_size": 1,
    "eval_batch_size": 1,
    "component_score_objective": "class_nll",
    "calibration_gate_objective": "class_nll",
    "monitor_objective": "class_nll",
    "harm_epsilon": 0.000001,
    "fedrot_align_schedule": "alternating",
    "fedrot_align_matrix": "a",
    "fedrot_rotation_lambda": 1.0,
    "spectral_surgery": {
      "policy": "smooth_abs",
      "core_frac": 0.2,
      "noise_frac": 0.2,
      "min_core_k": 1,
      "amp_factor": 1.25,
      "sup_factor": 0.8,
      "mid_factor": 1.0,
      "smooth_temperature": 0.35,
      "smooth_center_q": 0.5,
      "preserve_energy": "l1"
    },
    "rift_component_gain_mass": 1,
    "rift_gate_min_staleness": 4,
    "rift_gate_selection": "largest_safe_scale",
    "rift_gate_confidence_z": 0.25,
    "rift_max_mean_increase": 0,
    "rift_step_scales": [1, 0.5, 0.25],
    "rift_include_freshness_fallback": true,
    "late_tau": 4,
    "extreme_tau": 8,
    "rift_core": {
      "steps": 3,
      "learning_rate": 0.03,
      "radius": 0.5,
      "proximal_weight": 0.01,
      "delay_scale": 8
    }
  },
  "tasks": [
    {
      "name": "sst2",
      "subset": "sst2",
      "task": "sst2",
      "validation_split": "validation",
      "eval_split": "train",
      "reserve_eval_from_train": true,
      "eval_shuffle_seed": 271828,
      "text_column": "sentence",
      "label_texts": [" negative", " positive"],
      "eval_offset": 4096,
      "base_config": "configs/local_1_5b_rift_development.json",
      "label_column": "label",
      "max_train_examples": 512,
      "eval_examples": 1024,
      "model_overrides": {
        "max_length": 192
      }
    },
    {
      "name": "qnli",
      "subset": "qnli",
      "task": "qnli",
      "validation_split": "validation",
      "question_column": "question",
      "sentence_column": "sentence",
      "label_texts": [" yes", " no"],
      "eval_offset": 2048,
      "base_config": "configs/local_1_5b_rift_development.json",
      "label_column": "label",
      "max_train_examples": 512,
      "eval_examples": 1024,
      "model_overrides": {
        "max_length": 192
      }
    },
    {
      "name": "mnli_m",
      "run_name": "mnli_m",
      "subset": "mnli",
      "task": "mnli",
      "validation_split": "validation_matched",
      "premise_column": "premise",
      "hypothesis_column": "hypothesis",
      "label_texts": [" true", " unknown", " false"],
      "prompt_style": "truth_value",
      "eval_offset": 2048,
      "base_config": "configs/local_1_5b_rift_development.json",
      "label_column": "label",
      "max_train_examples": 512,
      "eval_examples": 1024,
      "model_overrides": {
        "max_length": 128
      }
    },
    {
      "name": "mnli_mm",
      "run_name": "mnli_mm",
      "subset": "mnli",
      "task": "mnli",
      "validation_split": "validation_mismatched",
      "premise_column": "premise",
      "hypothesis_column": "hypothesis",
      "label_texts": [" true", " unknown", " false"],
      "prompt_style": "truth_value",
      "eval_offset": 2048,
      "base_config": "configs/local_1_5b_rift_development.json",
      "label_column": "label",
      "max_train_examples": 512,
      "eval_examples": 1024,
      "model_overrides": {
        "max_length": 128
      }
    }
  ],
  "regimes": [
    {
      "name": "noniid_high_staleness",
      "partition_mode": "label_shard",
      "client_ranks": [2, 4, 8, 4],
      "compute_times": [1, 2, 5, 10]
    }
  ],
  "methods": [
    "raw",
    "freshness",
    "fedrot",
    "spectral_surgery",
    "alignfed_calibration",
    "rift",
    "rift_diag",
    "rift_core"
  ],
  "seeds": [6101, 6102, 6103, 6104, 6105, 6106],
  "gates": {
    "minimum_paired_seeds": 6,
    "minimum_acceptance_rate": 0.5,
    "minimum_client_return_coverage": 1,
    "minimum_late_events": 8,
    "hard_regimes": ["noniid_high_staleness"],
    "accuracy_noninferiority_margin_pp": -0.5,
    "nll_noninferiority_margin": -0.005,
    "requires_positive_late_harm_reduction": true,
    "requires_positive_cumulative_late_harm_reduction": true,
    "allow_equal_at_zero_harm": true,
    "quality_superiority": "ci95_any",
    "opponent_gates": {
      "rift": {
        "comparison_mode": "internal_ablation",
        "requires_positive_late_harm_reduction": false,
        "requires_positive_cumulative_late_harm_reduction": false,
        "quality_superiority": "ci95_any"
      },
      "rift_diag": {
        "comparison_mode": "full_core_ablation",
        "requires_positive_late_harm_reduction": false,
        "requires_positive_cumulative_late_harm_reduction": false,
        "quality_superiority": "ci95_any"
      }
    }
  },
  "notes": [
    "This v3 manifest must be committed before seeds 6101-6106 are run; every completed result must match that exact implementation commit.",
    "SST-2 holds out 1024 fixed train examples and removes them before client/calibration sampling. QNLI and both MNLI splits use 1024 validation examples starting at offset2048.",
    "FedRot uses the paper's alternating A/B special-orthogonal operator, adapted to one async return at a time. Spectral Surgery uses mean-absolute sensitivity, smooth magnitude reweighting and L1 preservation, adapted per async return.",
    "AlignFed calibration remains a whole-update safety proxy, not full AlignFed; full AlignFed requires buffered version groups, hidden-representation transforms, centering, participation weights and a different local objective.",
    "FedEx is excluded because its exact residual update to the frozen backbone requires synchronous client cohorts and mutable unquantized base weights; the existing fedex name is only a product-space async control.",
    "RIFT-Diag is retained as the equal-budget diagonal repair control needed to test whether full-core mixing contributes.",
    "Every seed has equal weight and no seed may be removed after inspecting any method result.",
    "This confirms immediate asynchronous aggregation only; buffer_size remains 1."
  ]
}
