{
  "model": {
    "name": "gokuls/BERT-tiny-sst2",
    "tokenizer_name": "gokuls/BERT-tiny-sst2",
    "target_suffixes": ["attention.self.query", "attention.self.value"],
    "max_length": 64
  },
  "dataset": {
    "hub_path": "nyu-mll/glue",
    "subset": "sst2",
    "train_split": "train",
    "validation_split": "validation",
    "text_column": "sentence",
    "label_column": "label",
    "fingerprint_audit": "outputs/week3/sst2_dataset_audit.json"
  },
  "experiment": {
    "seeds": [59, 71, 89],
    "num_clients": 10,
    "warmup_returns": 8,
    "collected_returns": 60,
    "local_steps": 4,
    "local_batch_size": 16,
    "local_learning_rate": 0.005,
    "weight_decay": 0.0,
    "gradient_clip_norm": 1.0,
    "server_update_weight": 0.1,
    "lora_scale_per_rank": 1.0,
    "eval_examples": 128,
    "eval_seed": 2026,
    "history_size": 8,
    "reference_rank": 4,
    "reference_decay": 0.1,
    "freshness_lambda": 0.17328679513998632,
    "rank_rtol": 1e-5,
    "regimes": [
      {
        "name": "iid_homogeneous",
        "partition": "iid",
        "ranks": [8, 8, 8, 8, 8, 8, 8, 8, 8, 8],
        "compute_times": [1.0, 1.1, 1.3, 1.6, 2.0, 2.5, 3.2, 4.2, 5.5, 8.0]
      },
      {
        "name": "iid_heterogeneous",
        "partition": "iid",
        "ranks": [4, 8, 16, 4, 8, 16, 4, 8, 16, 8],
        "compute_times": [1.0, 1.1, 1.3, 1.6, 2.0, 2.5, 3.2, 4.2, 5.5, 8.0]
      },
      {
        "name": "noniid_high_staleness",
        "partition": "label_shard",
        "shards_per_client": 2,
        "ranks": [4, 8, 16, 4, 8, 16, 4, 8, 16, 8],
        "compute_times": [1.0, 1.2, 1.8, 2.8, 4.0, 6.0, 9.0, 13.0, 18.0, 25.0]
      }
    ]
  },
  "output_dir": "outputs/week4_confirmation"
}
