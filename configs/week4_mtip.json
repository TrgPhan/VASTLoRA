{
  "model": {
    "name": "outputs/models/bert_tiny_sst2_clean",
    "tokenizer_name": "outputs/models/bert_tiny_sst2_clean",
    "target_suffixes": ["attention.self.query", "attention.self.value"],
    "max_length": 64
  },
  "dataset": {
    "hub_path": "nyu-mll/glue",
